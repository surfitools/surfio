<Window x:Class="Surfio.UrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open stream" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Stream or file URL" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Direct links and live streams: http(s), HLS (.m3u8), rtsp, rtmp, udp." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
        <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Play" Style="{StaticResource AccentDialogButton}" IsDefault="True" Click="Play_Click" />
        </StackPanel>
    </StackPanel>
</Window>
