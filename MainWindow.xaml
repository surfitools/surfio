<Window x:Class="Surfio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Surfio"
        Icon="Assets/surfio.ico"
        Width="1120" Height="680" MinWidth="560" MinHeight="360"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Top bar ============ -->
        <Border x:Name="TopBar" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="Assets/surfio.png" Width="20" Height="20" Margin="4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Surfio" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="OpenMenuButton" Style="{StaticResource BarButton}" Click="OpenMenu_Click" ToolTip="Open files, folders or a stream (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Open" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AudioMenuButton" Style="{StaticResource BarButton}" Click="AudioMenu_Click" ToolTip="Audio track and output device">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Audio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SubtitleMenuButton" Style="{StaticResource BarButton}" Click="SubtitleMenu_Click" ToolTip="Subtitles (V to cycle)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F0;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Subtitles" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoMenuButton" Style="{StaticResource BarButton}" Click="VideoMenu_Click" ToolTip="Aspect ratio, snapshot, window">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Video" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SpeedMenuButton" Style="{StaticResource BarButton}" Click="SpeedMenu_Click" ToolTip="Playback speed ( [ and ] )">
                        <TextBlock x:Name="SpeedText" Text="1×" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                    </Button>
                    <Border Width="1" Background="{StaticResource Line}" Margin="6,4" />
                    <Button x:Name="PlaylistToggle" Style="{StaticResource IconButton}" Content="&#xE8FD;" Click="PlaylistToggle_Click" ToolTip="Show/hide playlist (L)" Width="32" Height="30" />
                </StackPanel>

                <TextBlock x:Name="NowPlayingText" Text="" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0" />
            </DockPanel>
        </Border>

        <!-- ============ Video + playlist ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlaylistColumn" Width="310" />
            </Grid.ColumnDefinitions>

            <vlc:VideoView x:Name="Video" Background="Black">
                <!-- Overlay: lives in its own transparent window above the video -->
                <Grid x:Name="Overlay" Background="#01000000" Focusable="True" AllowDrop="True"
                      MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                      MouseRightButtonUp="Overlay_MouseRightButtonUp"
                      MouseMove="Overlay_MouseMove"
                      MouseWheel="Overlay_MouseWheel"
                      Drop="OnDrop" DragOver="OnDragOver"
                      PreviewKeyDown="OnPreviewKeyDown">

                    <!-- Empty state -->
                    <!-- Opaque: before VLC draws, the native video surface is Windows' default grey -->
                    <Grid x:Name="EmptyState" Background="{StaticResource Bg}" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="Assets/surfio.png" Width="72" Height="72" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Drop video or music here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,4" Foreground="{StaticResource Text}" />
                            <TextBlock Text="or press Ctrl+O to open files · Ctrl+Shift+O for a folder" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="13" />
                            <TextBlock x:Name="EmptyRecentHint" Text="" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Audio-only view -->
                    <Grid x:Name="AudioPanel" Visibility="Collapsed" IsHitTestVisible="False" Background="#FF0D0D0F">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <Border Width="240" Height="240" CornerRadius="8" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="72" Foreground="#FF3A3A40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AudioTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,4" TextTrimming="CharacterEllipsis" MaxWidth="520" Foreground="{StaticResource Text}" />
                            <TextBlock x:Name="AudioArtist" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        </StackPanel>
                    </Grid>

                    <!-- On-screen messages (volume, speed, seek...) -->
                    <Border x:Name="Osd" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,7" CornerRadius="4" Background="#CC000000" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="OsdText" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                    </Border>

                    <!-- Controls go here in fullscreen -->
                    <Border x:Name="OverlayControlsHost" VerticalAlignment="Bottom" Background="#E6111113" />
                </Grid>
            </vlc:VideoView>

            <!-- Playlist -->
            <Border x:Name="PlaylistPanel" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,6,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" Width="30" Height="30" FontSize="13" Click="AddFiles_Click" ToolTip="Add files" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Width="30" Height="30" FontSize="13" Click="SavePlaylist_Click" ToolTip="Save playlist (.m3u8)" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="30" Height="30" FontSize="13" Click="ClearPlaylist_Click" ToolTip="Clear playlist" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Playlist" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlaylistCount" Text="" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="8,1,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,8">
                        <TextBlock x:Name="PlaylistTotal" Foreground="{StaticResource Muted}" FontSize="12" Text="Drag files here to add them" />
                    </Border>

                    <Grid>
                        <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                                 ItemContainerStyle="{StaticResource PlaylistItem}" SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 MouseDoubleClick="PlaylistBox_MouseDoubleClick"
                                 KeyDown="PlaylistBox_KeyDown"
                                 ContextMenuOpening="PlaylistBox_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFEF4444" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PlaylistEmpty" Text="Nothing queued yet." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Controls ============ -->
        <Border x:Name="ControlsHost" Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Border x:Name="ControlBar" Padding="14,6,14,10">
                <StackPanel>
                    <!-- Seek row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeText" Text="0:00" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="52" />
                        <Grid Grid.Column="1" Margin="8,0">
                            <Slider x:Name="SeekSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseUp"
                                    ValueChanged="SeekSlider_ValueChanged"
                                    MouseMove="SeekSlider_MouseMove" MouseLeave="SeekSlider_MouseLeave"
                                    MouseWheel="SeekSlider_MouseWheel" />
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SeekHover" Canvas.Top="-26" Background="#FF232327" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                                    <TextBlock x:Name="SeekHoverText" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Text}" />
                                </Border>
                            </Canvas>
                        </Grid>
                        <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right"
                                   MouseLeftButtonUp="LengthText_Click" Cursor="Hand" ToolTip="Click to show time remaining" />
                    </Grid>

                    <!-- Buttons row -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;" Click="Shuffle_Click" ToolTip="Shuffle" />
                            <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;" Click="Repeat_Click" ToolTip="Repeat: off" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Click="Stop_Click" ToolTip="Stop" FontSize="14" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click" ToolTip="Previous (P)" Margin="6,0,0,0" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="PlayPause_Click" ToolTip="Play / pause (Space)" Margin="10,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next (N)" Margin="0,0,6,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE722;" Click="Snapshot_Click" ToolTip="Snapshot (S) — saved to Pictures\Surfio" FontSize="14" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute (M)" />
                            <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="110" Minimum="0" Maximum="150" Value="80" VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged" MouseWheel="VolumeSlider_MouseWheel" ToolTip="Volume (↑ ↓ or mouse wheel)" />
                            <TextBlock x:Name="VolumeText" Text="80%" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Width="40" TextAlignment="Right" />
                            <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="Fullscreen (F or double-click)" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
